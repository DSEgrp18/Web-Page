# Keep formatting consistent across editors and the team's Windows machines.
# See .gitattributes for what is actually stored in Git.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Trailing whitespace is meaningful in Markdown line breaks.
trim_trailing_whitespace = false

[*.tsv]
# Vendored mapping tables are byte-verified; never reformat them.
indent_style = tab
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
